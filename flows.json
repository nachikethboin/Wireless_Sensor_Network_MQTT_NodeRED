    {
        "id": "343df46eb21de9e5",
        "type": "function",
        "z": "6a6448d358141dbc",
        "name": "function 1",
        "func": "// Split the text at the colons\nvar parts = msg.payload.split(\":\");\n\n// The temperature is the last part, convert it to a pure number\nvar temp = Number(parts.pop());\n\n// The rest is the MAC address\nvar mac = parts.join(\":\");\n\n// Overwrite the payload with just the temperature number\nmsg.payload = temp;\n\n// Route to Output 1 or Output 2 based on the MAC address from your screenshot\nif (mac === \"00:13:a2:00:42:08:b2:ce\") {\n    return [msg, null]; \n} else if (mac === \"00:13:a2:00:42:08:b4:45\") {\n    return [null, msg]; \n}\n\nreturn [null, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
